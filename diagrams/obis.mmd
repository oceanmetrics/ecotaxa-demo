%%{init: {"flowchart": {"wrappingWidth": 220, "nodeSpacing": 30, "rankSpacing": 60}}}%%
flowchart LR
  subgraph et["EcoTaxa (REST API, token login)"]
    direction TB
    P["project<br/>(instrument, license, contacts)"]:::node
    S["samples<br/>(lat, lon, date, depth, volume)"]:::node
    A["acquisitions<br/>(instrument settings)"]:::node
    O["objects<br/>(category, status validated / predicted,<br/>annotator, size features, image)"]:::node
    P --> S --> A --> O
  end
  O --> X["01 export<br/>TSV + images<br/>(cached locally)"]:::node
  X --> W["02 taxa<br/>EcoTaxa category to WoRMS<br/>reviewable lookup table:<br/>AphiaID, rank, or excluded<br/>(detritus, egg, t001)"]:::core
  W --> E["03 Event core<br/>one row per sample (+ acquisition)<br/>eventID, eventDate, lat/lon, depth,<br/>samplingProtocol, sampleSizeValue"]:::core
  W --> OC["03 Occurrence<br/>validated objects aggregated<br/>per sample x taxon<br/>scientificNameID = WoRMS LSID<br/>identificationVerificationStatus"]:::core
  W --> M["03 eMoF<br/>abundance, concentration,<br/>biovolume, size<br/>NERC P01 / P06 URIs"]:::core
  W -.-> AC["Audubon Core (optional)<br/>image URLs per object"]:::core
  E & OC & M & AC --> Z["EML + meta.xml<br/>DwC-A zip + manifest<br/>validate (obistools)"]:::core
  Z --> IPT["OBIS-USA IPT<br/>(manual upload)"]:::ext --> OBIS["OBIS"]:::ext --> GBIF["GBIF"]:::ext
  classDef node     fill:#ffffff,stroke:#8a9bb0,color:#1f2d3d
  classDef core     fill:#e6f1ea,stroke:#4f8a66,color:#173322
  classDef ext      fill:#e8eff7,stroke:#5b7a99,color:#1a2b3c
  style et fill:#f7f9fb,stroke:#cfd6de,color:#4a5a6a
