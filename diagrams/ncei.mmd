flowchart LR
  subgraph src["Inputs (per EcoTaxa project, dated version)"]
    direction TB
    IMG["images\n(vault, one file per object)"]
    TSV["EcoTaxa TSV export\n(objects, samples, acquisitions, process)"]
    DWCA["DwC-A zip\n(from the OBIS pipeline)"]
    MD["project metadata\n(EML, contacts, license, instrument)"]
  end
  IMG & TSV & DWCA & MD --> B["04 build package\nBagIt-style layout\nmanifest + SHA-256 checksums\nISO 19115-2 / ACDD metadata record\nversion YYYY-MM-DD"]
  B --> V["verify\nre-hash, count, schema checks"]
  V --> ST[("staging copy\nobject storage (R2 / NODD)")]
  ST --> SUB["NCEI submission\n(S2N / ATRAC: route to agree\nwith NCEI and Matt Biddle)"]
  SUB --> ACC["NCEI accession\nDOI, landing page"]
  ACC -.->|"DOI back into"| DWCA
  classDef ext fill:#eef3f8,stroke:#5b7a99,color:#1a2b3c;
  classDef prop fill:#fff8e1,stroke:#b8860b,color:#3a2e00;
  class ACC ext;
  class SUB prop;
